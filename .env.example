# Firebase Web app configuration (copy this file to .env and fill in values).
# These VITE_* values are public browser configuration, not private credentials.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Existing P3 email backend (optional; only used for contact/subscription forms).
GMAIL_USER=siddidsaini08@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password
PORT=5000
